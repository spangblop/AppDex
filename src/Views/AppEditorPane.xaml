<UserControl x:Class="GameShelf.AppEditorPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource AppText}" FontFamily="{DynamicResource AppBodyFont}" FontSize="{DynamicResource AppBodySize}" UseLayoutRounding="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="EditorField" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppControl}"/><Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppText}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,7"/><Setter Property="BorderBrush" Value="{DynamicResource AppEdge}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1"
              BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
          </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="0,0,0,5"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="0">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppDanger}" TextWrapping="Wrap" Visibility="Collapsed"
          Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
      <Border x:Name="RemovePrompt" Visibility="Collapsed" CornerRadius="6" Background="{DynamicResource AppPanel}" Padding="10" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock x:Name="RemoveQuestion" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <WrapPanel>
            <Button x:Name="KeepAppButton" Style="{StaticResource ActionButton}" Content="Keep app" Margin="0,0,6,0" Click="KeepApp"/>
            <Button x:Name="ConfirmRemoveButton" Style="{StaticResource ActionButton}" Content="Remove app" Foreground="{DynamicResource AppDanger}" Click="ConfirmRemove"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="RemoveAppButton" Style="{StaticResource ActionButton}" Content="Remove from AppDex…" Visibility="Collapsed"
            Foreground="{DynamicResource AppDanger}" Margin="0,0,8,3" Click="RequestRemove"/>
        <Button Style="{StaticResource ActionButton}" Content="Cancel" Click="Cancel" Margin="0,0,8,3"/>
        <Button x:Name="SaveButton" Style="{StaticResource ActionButton}" Foreground="{DynamicResource AppAccentInk}" Margin="0,0,0,3"
            Background="{DynamicResource AppAccent}" BorderBrush="{DynamicResource AppAccent}" FontWeight="Bold" IsDefault="True" Click="OnSave"/>
      </WrapPanel>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <Label Content="App name" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=GameName}"/>
        <TextBox x:Name="GameName" Style="{StaticResource EditorField}" AutomationProperties.Name="App name"/>
        <Label Content="Search aliases" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=SearchAliases}" Margin="0,16,0,0"/>
        <TextBox x:Name="SearchAliases" Style="{StaticResource EditorField}" AutomationProperties.Name="Search aliases"
            AutomationProperties.HelpText="Enter nicknames separated by commas."/>
        <StackPanel x:Name="ExecutableFields" Margin="0,15,0,0">
          <Label Content="App executable" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Executable}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource ActionButton}"
                Margin="8,0,0,0" Click="BrowseGame" AutomationProperties.Name="Browse for app executable"/>
            <TextBox x:Name="Executable" Style="{StaticResource EditorField}" AutomationProperties.Name="App executable" HorizontalScrollBarVisibility="Hidden"/>
          </DockPanel>
        </StackPanel>
        <Label Content="App picture" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Height="68" CornerRadius="6" BorderBrush="#546057" BorderThickness="1">
            <Border.Background><ImageBrush x:Name="PicturePreview" Stretch="UniformToFill"/></Border.Background>
          </Border>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Content="Choose picture…" Click="BrowsePicture" Style="{StaticResource ActionButton}" Margin="0,2,6,2"/>
            <Button x:Name="ResetPicture" Content="Use default" Click="UseDefaultPicture" Style="{StaticResource ActionButton}" Margin="0,2,0,2"/>
            <Button x:Name="SteamPicture" Content="Update from Steam" Click="UpdateSteamPicture" Style="{StaticResource ActionButton}"
                Margin="0,3,0,0" Visibility="Collapsed"/>
          </WrapPanel>
        </Grid>
        <Label Content="Launch profiles" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ProfilePicker}" Margin="0,16,0,0"/>
        <DockPanel>
          <WrapPanel DockPanel.Dock="Right">
            <Button Content="Add profile" Click="AddProfile" Style="{StaticResource ActionButton}" Margin="6,0,0,0"/>
            <Button x:Name="RemoveProfileButton" Content="Remove" Click="RemoveProfile" Style="{StaticResource ActionButton}" Margin="6,0,0,0"/>
          </WrapPanel>
          <ComboBox x:Name="ProfilePicker" Height="32" SelectionChanged="ChangeProfile" AutomationProperties.Name="Launch profile"/>
        </DockPanel>
        <StackPanel x:Name="ProfileFields" Visibility="Collapsed">
          <Label Content="Profile name" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ProfileName}" Margin="0,8,0,0"/>
          <TextBox x:Name="ProfileName" Style="{StaticResource EditorField}" AutomationProperties.Name="Profile name"/>
          <Label Content="Executable override (optional)" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=ProfileExecutable}" Margin="0,8,0,0"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource ActionButton}" Click="BrowseProfileExecutable" Margin="8,0,0,0"/>
            <TextBox x:Name="ProfileExecutable" Style="{StaticResource EditorField}" AutomationProperties.Name="Profile executable"/>
          </DockPanel>
        </StackPanel>
        <Label Content="Launch arguments (optional)" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=Arguments}" Margin="0,12,0,0"/>
        <TextBox x:Name="Arguments" Style="{StaticResource EditorField}" AutomationProperties.Name="Launch arguments" HorizontalScrollBarVisibility="Hidden"/>
        <TextBlock Text="Use quotes around values that contain spaces." Foreground="{DynamicResource AppMuted}" FontSize="12"
            Margin="0,5,0,2" TextWrapping="Wrap"/>
        <Label Content="Launch shortcut" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=RecordShortcut}" Margin="0,16,0,0"/>
        <WrapPanel>
          <Button x:Name="RecordShortcut" Style="{StaticResource ActionButton}" MinWidth="130" Margin="0,0,6,0"
              Click="BeginShortcutCapture" LostKeyboardFocus="CancelShortcutCapture"
              AutomationProperties.HelpText="Press to record a shortcut for this app."/>
          <Button x:Name="ClearShortcut" Content="Clear" Style="{StaticResource ActionButton}" Click="RemoveShortcut"/>
        </WrapPanel>
        <TextBlock x:Name="ShortcutHint" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,0"
            Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel x:Name="PlayStatsFields" Visibility="Collapsed" Margin="0,16,0,0">
          <TextBlock Text="Play stats" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Statistics}" Foreground="{DynamicResource AppMuted}" Margin="0,4,0,7"/>
          <Button x:Name="ResetStatsButton" Content="Reset play stats…" Click="RequestStatsReset"
              HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Foreground="{DynamicResource AppDanger}"/>
          <Border x:Name="ResetStatsPrompt" Visibility="Collapsed" Margin="0,8,0,0" Padding="9"
              Background="{DynamicResource AppControl}" CornerRadius="{DynamicResource AppControlCorner}">
            <StackPanel>
              <TextBlock Text="Clear this app’s recorded playtime and launch count?" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button x:Name="KeepStatsButton" Content="Keep stats" Click="KeepStats" Margin="0,0,6,0"
                    Style="{StaticResource ActionButton}"/>
                <Button x:Name="ConfirmResetStatsButton" Content="Reset stats" Click="ConfirmStatsReset"
                    Style="{StaticResource ActionButton}" Foreground="{DynamicResource AppDanger}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ResetStatsStatus" Foreground="{DynamicResource AppMuted}" Margin="0,5,0,0"
              TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
