<Window x:Class="GameShelf.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GameShelf"
    Title="AppDex" Icon="pack://application:,,,/AppDex;component/Assets/AppDex.ico" Background="{DynamicResource AppBackground}"
    Foreground="{DynamicResource AppText}" FontFamily="{DynamicResource AppBodyFont}" FontSize="{DynamicResource AppBodySize}"
    Width="1110" Height="690" MinWidth="340" MinHeight="340"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="TileLaunchSpinner" TargetType="local:LaunchSpinner">
      <Setter Property="IsActive" Value="{Binding Launching}"/>
      <Setter Property="Animated" Value="{DynamicResource AppSpinnerAnimation}"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TileGlow" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentText}"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Margin" Value="-3"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Effect"><Setter.Value>
        <DropShadowEffect Color="{DynamicResource AppHoverGlow}" ShadowDepth="0" BlurRadius="{DynamicResource AppGlowBlur}" Opacity="1"/>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="CoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Statistics}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent"><Grid x:Name="TileSurface">
            <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
            <Grid Background="Transparent">
              <Border CornerRadius="{DynamicResource AppTileCorner}" Background="{DynamicResource AppTileSurface}"/>
              <Border x:Name="ArtworkSurface" CornerRadius="{DynamicResource AppTileCorner}">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding Artwork}" Stretch="{DynamicResource AppCrop}" Opacity="{DynamicResource AppArtworkOpacity}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
              </Border>
              <Border CornerRadius="{DynamicResource AppTileCorner}" Opacity="{DynamicResource AppCoverShade}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#000A0E11" Offset="0.16"/>
                    <GradientStop Color="#150A0E11" Offset="0.39"/>
                    <GradientStop Color="#AC0A0E11" Offset="0.76"/>
                    <GradientStop Color="#F10A0E11" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Grid x:Name="Caption" Margin="12,0,12,12" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Bottom">
                  <TextBlock Text="{Binding PlatformStatus}" Visibility="Collapsed" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                      Foreground="#E3E9E8" Margin="1,0,0,4"/>
                  <TextBlock x:Name="TileTitle" Text="{Binding Name}" FontSize="{DynamicResource AppTileTitleSize}" FontWeight="Bold"
                      Foreground="{DynamicResource AppCoverInk}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="TileDetails" Text="{Binding Statistics}" Visibility="{DynamicResource AppStatsVisibility}" FontSize="{DynamicResource AppTileDetailSize}" FontWeight="Medium" Foreground="{DynamicResource AppCoverInk}"
                      Margin="1,4,0,0" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Bottom">
                  <Border x:Name="PlayCircle" Visibility="{DynamicResource AppPlayVisibility}" Width="34" Height="34"
                      Background="#C91C2425" CornerRadius="17" BorderBrush="#91DDE3DD" BorderThickness="1">
                    <Path x:Name="Triangle" Fill="#F4F8EF" Data="M 0,0 L 0,12 L 10,6 Z" Stretch="None"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                  </Border>
                  <local:LaunchSpinner x:Name="LoadingSpinner" Style="{StaticResource TileLaunchSpinner}" Width="40" Height="40" Margin="-3"/>
                </Grid>
              </Grid>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Padding="7,3" CornerRadius="5"
                  Background="#ED131817" IsHitTestVisible="False" Visibility="{DynamicResource AppSourceVisibility}">
                <TextBlock Text="{Binding SourceStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border x:Name="Outline" CornerRadius="{DynamicResource AppTileCorner}" BorderThickness="{DynamicResource AppTileOutline}" BorderBrush="{DynamicResource AppEdge}" IsHitTestVisible="False"/>
              <Button x:Name="EditButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                  Width="31" Height="31" Style="{StaticResource ActionButton}" Background="#D31B211E" Padding="6"
                  BorderBrush="#8DA29995" Cursor="Hand" AutomationProperties.Name="{Binding EditName}"
                  ToolTip="{Binding EditName}" Visibility="{DynamicResource AppEditVisibility}" Click="EditCover">
                <Path Fill="White" Width="15" Height="15" Stretch="Uniform"
                    Data="M2,12 L2,16 6,15 15,6 12,3 Z M13,2 L16,5 17,4 Q18,3 17,2 L16,1 Q15,0 14,1 Z"/>
              </Button>
            </Grid>
        <Border x:Name="HoverSweep" IsHitTestVisible="False" CornerRadius="{DynamicResource AppTileCorner}"/>
        <local:TileLaunchCue x:Name="LaunchCue"/>
            </Grid></Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                <Setter TargetName="PlayCircle" Property="Background" Value="{DynamicResource AppAccent}"/>
                <Setter TargetName="PlayCircle" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                <Setter TargetName="Triangle" Property="Fill" Value="{DynamicResource AppAccentInk}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                <Setter TargetName="Outline" Property="BorderThickness" Value="3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PlayCircle" Property="Background" Value="White"/>
                <Setter TargetName="Triangle" Property="Fill" Value="{DynamicResource AppAccentInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AlternateCoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Statistics}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="TileSurface">
        <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
        <Border x:Name="Frame" CornerRadius="{DynamicResource AppTileCorner}" Background="{DynamicResource AppTileSurface}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="{DynamicResource AppTileOutline}" Padding="5">
          <Grid>
            <Grid.RowDefinitions><RowDefinition x:Name="ArtRow"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtColumn"/><ColumnDefinition x:Name="TextColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="ArtworkSurface" CornerRadius="{DynamicResource AppArtworkCorner}" ClipToBounds="True">
              <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="{DynamicResource AppCrop}" Opacity="{DynamicResource AppArtworkOpacity}"/></Border.Background>
            </Border>
            <Border CornerRadius="4" Background="#ED15191C" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="5,2" Visibility="{DynamicResource AppSourceVisibility}">
              <TextBlock Text="{Binding SourceStatus}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Grid x:Name="LabelArea" Grid.Row="1" Margin="7,8,5,3" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TileTitle" Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="{DynamicResource AppTileTitleSize}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TileDetails" Text="{Binding Statistics}" Visibility="{DynamicResource AppStatsVisibility}" Foreground="{DynamicResource AppMuted}" FontSize="{DynamicResource AppTileDetailSize}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Visibility="{DynamicResource AppPlayVisibility}" Text="▶" FontSize="13" Foreground="{DynamicResource AppAccentText}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <local:LaunchSpinner x:Name="LoadingSpinner" Style="{StaticResource TileLaunchSpinner}" Margin="-3"/>
              </Grid>
            </Grid>
            <Button x:Name="EditButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                Width="26" Height="26" Padding="0" Style="{StaticResource ActionButton}" Background="#EA15191C" Foreground="White"
                AutomationProperties.Name="{Binding EditName}" ToolTip="{Binding EditName}" Visibility="{DynamicResource AppEditVisibility}" Click="EditCover">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"/>
            </Button>
          </Grid>
        </Border>
        <Border x:Name="HoverSweep" IsHitTestVisible="False" CornerRadius="{DynamicResource AppTileCorner}"/>
        <local:TileLaunchCue x:Name="LaunchCue"/>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="Compact">
            <Setter TargetName="ArtRow" Property="Height" Value="*"/>
            <Setter TargetName="ArtColumn" Property="Width" Value=".42*"/>
            <Setter TargetName="ArtColumn" Property="MaxWidth" Value="{DynamicResource AppSideArtworkMax}"/>
            <Setter TargetName="TextColumn" Property="Width" Value="*"/>
            <Setter TargetName="LabelArea" Property="Grid.Row" Value="0"/>
            <Setter TargetName="LabelArea" Property="Grid.Column" Value="1"/>
            <Setter TargetName="LabelArea" Property="Margin" Value="10,4,34,4"/>
            <Setter TargetName="EditButton" Property="Grid.Column" Value="1"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppControl}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ArcadeCoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Statistics}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="TileSurface">
        <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
        <Border x:Name="Cabinet" Background="{DynamicResource AppTileSurface}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="{DynamicResource AppTileOutline}" CornerRadius="{DynamicResource AppTileCorner}"
            Padding="4">
          <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="ArtworkSurface" CornerRadius="{DynamicResource AppArtworkCorner}">
              <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="{DynamicResource AppCrop}" Opacity="{DynamicResource AppArtworkOpacity}"/></Border.Background>
            </Border>
            <Border Opacity=".24" Background="#24163D" IsHitTestVisible="False"/>
            <Path Fill="{DynamicResource AppAccent}" Data="M 0,0 L 17,0 0,16 Z" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False"/>
            <Grid Grid.Row="1" Background="{DynamicResource AppTileSurface}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="8,6,5,5">
                <TextBlock x:Name="TileTitle" Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="{DynamicResource AppTileTitleSize}"
                    TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TileDetails" Text="{Binding Statistics}" Visibility="{DynamicResource AppStatsVisibility}" Foreground="{DynamicResource AppMuted}" FontSize="{DynamicResource AppTileDetailSize}"
                    Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center" Margin="3,5,5,5">
                <Border Visibility="{DynamicResource AppPlayVisibility}" Width="28" Height="24" CornerRadius="2" Background="{DynamicResource AppAccentOnDark}">
                  <TextBlock Text="▶" Foreground="#181A28" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <local:LaunchSpinner x:Name="LoadingSpinner" Style="{StaticResource TileLaunchSpinner}" Width="30" Height="30" Margin="-3"/>
              </Grid>
            </Grid>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F218192A" Padding="5,2" Margin="8,5,0,0" CornerRadius="1" Visibility="{DynamicResource AppSourceVisibility}">
              <TextBlock Text="{Binding SourceStatus}" Foreground="{DynamicResource AppAccentOnDark}"
                  FontSize="10" FontWeight="Bold"/>
            </Border>
            <Button Width="26" Height="25" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                Background="#EC181B2C" Foreground="White" Style="{StaticResource ActionButton}" Visibility="{DynamicResource AppEditVisibility}" Click="EditCover"
                AutomationProperties.Name="{Binding EditName}" ToolTip="{Binding EditName}">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/>
            </Button>
          </Grid>
        </Border>
        <Border x:Name="HoverSweep" IsHitTestVisible="False" CornerRadius="{DynamicResource AppTileCorner}"/>
        <local:TileLaunchCue x:Name="LaunchCue"/>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Cabinet" Property="BorderBrush" Value="{DynamicResource AppAccentOnDark}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Cabinet" Property="BorderBrush" Value="{DynamicResource AppAccentOnDark}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MarqueeCoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Statistics}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="TileSurface">
        <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
        <Border x:Name="Paper" BorderBrush="{DynamicResource AppEdge}" BorderThickness="{DynamicResource AppTileOutline}" Background="{DynamicResource AppTileSurface}" Padding="6" CornerRadius="{DynamicResource AppTileCorner}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding SourceStatus}" Visibility="{DynamicResource AppSourceVisibility}" Foreground="{DynamicResource AppAccentText}" FontSize="10.5" FontWeight="Bold"
                Margin="3,3,27,2" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="ArtworkSurface" Grid.Row="1" CornerRadius="{DynamicResource AppArtworkCorner}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="1">
              <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="{DynamicResource AppCrop}" Opacity="{DynamicResource AppArtworkOpacity}"/></Border.Background>
            </Border>
            <Grid Grid.Row="2" Margin="3,7,3,3">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TileTitle" Text="{Binding Name}" FontSize="{DynamicResource AppTileTitleSize}" Foreground="{DynamicResource AppText}"
                    FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                <TextBlock x:Name="TileDetails" Text="{Binding Statistics}" Visibility="{DynamicResource AppStatsVisibility}" Foreground="{DynamicResource AppMuted}" FontSize="{DynamicResource AppTileDetailSize}" Margin="0,3,0,0"
                    TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Visibility="{DynamicResource AppPlayVisibility}" Text="↗" Foreground="{DynamicResource AppAccentText}" FontWeight="Bold" FontSize="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <local:LaunchSpinner x:Name="LoadingSpinner" Style="{StaticResource TileLaunchSpinner}" Width="26" Height="26" Margin="-3"/>
              </Grid>
            </Grid>
            <Button Width="22" Height="21" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                Style="{StaticResource ActionButton}" Visibility="{DynamicResource AppEditVisibility}" Click="EditCover" AutomationProperties.Name="{Binding EditName}" ToolTip="{Binding EditName}">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
            </Button>
          </Grid>
        </Border>
        <Border x:Name="HoverSweep" IsHitTestVisible="False" CornerRadius="{DynamicResource AppTileCorner}"/>
        <local:TileLaunchCue x:Name="LaunchCue"/>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Paper" Property="BorderBrush" Value="{DynamicResource AppAccentText}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="{DynamicResource AppAccentText}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlightDeckCoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding Statistics}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="TileSurface">
        <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
        <Border x:Name="Frame" BorderBrush="{DynamicResource AppEdge}" BorderThickness="{DynamicResource AppTileOutline}" Background="{DynamicResource AppTileSurface}"
            Padding="5" CornerRadius="{DynamicResource AppTileCorner}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width=".33*" MaxWidth="{DynamicResource AppSideArtworkMax}"/><ColumnDefinition Width=".67*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="ArtworkSurface" CornerRadius="{DynamicResource AppArtworkCorner}">
              <Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="{DynamicResource AppCrop}" Opacity="{DynamicResource AppArtworkOpacity}"/></Border.Background>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource AppEdge}" BorderThickness="1,0,0,0" Margin="6,0,0,0" Padding="9,5,3,4">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SourceStatus}" Visibility="{DynamicResource AppSourceVisibility}" Foreground="{DynamicResource AppAccentText}"
                    FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TileTitle" Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontWeight="Bold" FontSize="{DynamicResource AppTileTitleSize}"
                    Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TileDetails" Text="{Binding Statistics}" Visibility="{DynamicResource AppStatsVisibility}" Foreground="{DynamicResource AppMuted}"
                    FontSize="{DynamicResource AppTileDetailSize}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Grid Grid.Column="2" Width="26" Margin="2,0,0,0">
              <Button Width="25" Height="24" VerticalAlignment="Top" Padding="0" Style="{StaticResource ActionButton}" Visibility="{DynamicResource AppEditVisibility}" Click="EditCover"
                  AutomationProperties.Name="{Binding EditName}" ToolTip="{Binding EditName}">
                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
              </Button>
              <Path Visibility="{DynamicResource AppPlayVisibility}" Data="M 0,0 L 6,5 0,10" Stroke="{DynamicResource AppAccentText}" StrokeThickness="2"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
              <local:LaunchSpinner x:Name="LoadingSpinner" Style="{StaticResource TileLaunchSpinner}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="HoverSweep" IsHitTestVisible="False" CornerRadius="{DynamicResource AppTileCorner}"/>
        <local:TileLaunchCue x:Name="LaunchCue"/>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccentText}"/>
            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppControl}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccentText}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GroupCoverButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppTileFont}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent"><Grid x:Name="TileSurface">
        <Border x:Name="HoverGlow" Style="{StaticResource TileGlow}" CornerRadius="{DynamicResource AppGlowCorner}"/>
        <Border x:Name="Frame" CornerRadius="{DynamicResource AppTileCorner}" Background="{DynamicResource AppPanel}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="{DynamicResource AppTileOutline}" Padding="5"
            RenderTransformOrigin=".5,.5">
          <Grid>
            <Grid.RowDefinitions><RowDefinition x:Name="ArtworkRow"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ArtworkColumn"/><ColumnDefinition x:Name="TextColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid x:Name="ArtworkSurface" ClipToBounds="True">
              <ContentPresenter/>
              <Border VerticalAlignment="Bottom" Height="33" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#000C1115" Offset="0"/><GradientStop Color="#B00C1115" Offset="1"/>
                </LinearGradientBrush></Border.Background>
              </Border>
              <Border Background="#EC171E25" CornerRadius="5" Padding="6,3" Margin="5"
                  VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                <TextBlock Text="GROUP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentOnDark}"/>
              </Border>
            </Grid>
            <Grid x:Name="GroupLabel" Grid.Row="1" Margin="7,7,6,4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="TileTitle" Text="{Binding Name}" FontSize="{DynamicResource AppTileTitleSize}" FontWeight="Bold"
                    Foreground="{DynamicResource AppText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TileDetails" Text="{Binding Apps.Count, StringFormat='{}{0} apps'}" Visibility="{DynamicResource AppStatsVisibility}" FontSize="{DynamicResource AppTileDetailSize}" Foreground="{DynamicResource AppMuted}" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="›" Foreground="{DynamicResource AppAccentText}" FontSize="22" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <Button x:Name="More" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Width="27" Height="26" Padding="0"
                Style="{StaticResource ActionButton}" Background="#EA15191C" Foreground="White" Content="···"
                AutomationProperties.Name="Group options" ToolTip="Group options" Click="GroupMore"/>
          </Grid>
        </Border>
        </Grid></Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="Compact">
            <Setter TargetName="ArtworkRow" Property="Height" Value="*"/>
            <Setter TargetName="ArtworkColumn" Property="Width" Value=".42*"/>
            <Setter TargetName="ArtworkColumn" Property="MaxWidth" Value="{DynamicResource AppSideArtworkMax}"/>
            <Setter TargetName="TextColumn" Property="Width" Value="*"/>
            <Setter TargetName="GroupLabel" Property="Grid.Row" Value="0"/>
            <Setter TargetName="GroupLabel" Property="Grid.Column" Value="1"/>
            <Setter TargetName="GroupLabel" Property="Margin" Value="10,4,36,4"/>
            <Setter TargetName="More" Property="Grid.Column" Value="1"/>
          </Trigger>
          <Trigger Property="Tag" Value="Flight Deck">
            <Setter TargetName="ArtworkRow" Property="Height" Value="*"/>
            <Setter TargetName="ArtworkColumn" Property="Width" Value=".46*"/>
            <Setter TargetName="ArtworkColumn" Property="MaxWidth" Value="{DynamicResource AppSideArtworkMax}"/>
            <Setter TargetName="TextColumn" Property="Width" Value="*"/>
            <Setter TargetName="GroupLabel" Property="Grid.Row" Value="0"/>
            <Setter TargetName="GroupLabel" Property="Grid.Column" Value="1"/>
            <Setter TargetName="GroupLabel" Property="Margin" Value="11,4,33,4"/>
            <Setter TargetName="More" Property="Grid.Column" Value="1"/>
          </Trigger>
          <Trigger Property="Tag" Value="Marquee">
            <Setter TargetName="GroupLabel" Property="Margin" Value="8,9,8,7"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AppControl}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Page" LayoutTransform="{DynamicResource AppScale}" Background="{DynamicResource AppCanvas}">
    <Border Background="{DynamicResource AppWallpaper}" IsHitTestVisible="False"/>
    <Border Background="{DynamicResource AppTexture}" IsHitTestVisible="False"/>
    <Grid x:Name="Shell">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="HeaderBar" Background="{DynamicResource AppPanel}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="0,0,0,1" Padding="18,11">
        <DockPanel>
          <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Width="34" Height="34" Padding="0" Margin="7,0,0,0"
              ToolTip="Settings" AutomationProperties.Name="Settings" Click="OpenSettings">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/>
          </Button>
          <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Width="34" Height="34" Padding="0"
              ToolTip="Toggle fullscreen (F11)" AutomationProperties.Name="Toggle fullscreen" Click="FullscreenClick">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="15"/>
          </Button>
          <StackPanel DockPanel.Dock="Right" Visibility="{DynamicResource AppPlaytimeVisibility}" Margin="8,0,13,0" VerticalAlignment="Center"
              ToolTip="Total tracked playtime for all apps in your library">
            <TextBlock x:Name="TotalPlaytimeLabel" Text="Total playtime" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource AppMuted}"/>
            <TextBlock x:Name="TotalPlaytime" Text="0h 00m" FontSize="15" FontWeight="Bold" TextAlignment="Right"
                Foreground="{DynamicResource AppAccentText}"/>
          </StackPanel>
          <DockPanel VerticalAlignment="Center">
            <Image x:Name="AppMark" DockPanel.Dock="Left" Source="pack://application:,,,/AppDex;component/Assets/AppDexMark.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,9,0"
                MouseLeftButtonDown="DeveloperLogoClick"/>
            <StackPanel>
              <WrapPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="AppTitle" Text="AppDex" FontSize="24" FontWeight="Bold" FontFamily="{DynamicResource AppDisplayFont}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="VersionLabel" Text="Beta" FontSize="11" VerticalAlignment="Center" Margin="8,2,0,0" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <Button x:Name="UpdateAvailableButton" Content="Update available" Click="OpenAvailableUpdate"
                    Style="{StaticResource ActionButton}" Visibility="Collapsed" VerticalAlignment="Center" FontSize="11"
                    Margin="8,2,0,2" Padding="7,3" Background="{DynamicResource AppAccent}"
                    Foreground="{DynamicResource AppAccentInk}" BorderBrush="{DynamicResource AppAccent}"/>
              </WrapPanel>
              <TextBlock Text="by Spangblop" FontSize="11" Foreground="{DynamicResource AppMuted}"/>
            </StackPanel>
          </DockPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" x:Name="Body">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="175"/><ColumnDefinition x:Name="LibraryColumn"/></Grid.ColumnDefinitions>
        <Border x:Name="PinnedRail" Background="{DynamicResource AppPanel}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="0,0,1,0" Padding="12,15,12,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <Button x:Name="LibraryHome" Style="{StaticResource ActionButton}" Content="Library" Click="GoHome"
                  HorizontalContentAlignment="Left" Padding="9,6" Margin="0,0,0,17"/>
              <TextBlock Text="Pinned" Foreground="{DynamicResource AppMuted}" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,9"/>
            </StackPanel>
            <local:LibraryScrollViewer x:Name="PinnedScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
              <StackPanel x:Name="Pinned"/>
            </local:LibraryScrollViewer>
          </DockPanel>
        </Border>
        <Grid x:Name="LibraryArea" Grid.Column="1" Margin="19,13,13,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button x:Name="BackToLibrary" DockPanel.Dock="Left" Style="{StaticResource ActionButton}" Content="←" Width="31" Height="31"
                Margin="0,0,9,0" Padding="0" Visibility="Collapsed" Click="GoHome" AutomationProperties.Name="Back to library" ToolTip="Back to library"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}" Margin="9,0,0,0"/>
            <TextBlock x:Name="ViewTitle" Text="Library" FontSize="{DynamicResource AppHeadingSize}" FontWeight="Bold" FontFamily="{DynamicResource AppDisplayFont}"
                TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
          <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Border x:Name="SearchField" Background="{DynamicResource AppPanel}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="1"
                CornerRadius="{DynamicResource AppControlCorner}" Margin="0,0,7,5" Padding="8,0" Height="34" Width="180">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontSize="13" FontFamily="Segoe MDL2 Assets"
                    Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Grid>
                  <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                      Foreground="{DynamicResource AppText}" CaretBrush="{DynamicResource AppText}" FontSize="13" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Search apps" ToolTip="Search apps (Ctrl+F)"/>
                  <TextBlock x:Name="SearchHint" Text="Search apps" Foreground="{DynamicResource AppMuted}"
                      FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
              </DockPanel>
            </Border>
            <ComboBox x:Name="SortPicker" Height="34" MinWidth="141" Margin="0,0,7,5" AutomationProperties.Name="Sort apps">
              <ComboBoxItem Content="Highest launch count"/><ComboBoxItem Content="Highest play time"/><ComboBoxItem Content="Custom order"/>
            </ComboBox>
            <Button x:Name="PreviewSortButton" Content="Highest launch count ▾" Height="34" Margin="0,0,7,5" Padding="8,4"
                MinWidth="{Binding MinWidth, ElementName=SortPicker}" HorizontalContentAlignment="Left" FontSize="13"
                Style="{StaticResource ActionButton}" Visibility="Collapsed" AutomationProperties.Name="Sort apps" Click="PreviewPickerClick"/>
            <ComboBox x:Name="SourcePicker" Height="34" MinWidth="99" Margin="0,0,7,5" AutomationProperties.Name="Launch source">
              <ComboBoxItem Content="All sources"/><ComboBoxItem Content="Steam"/><ComboBoxItem Content="Windows"/><ComboBoxItem Content="Epic Games"/>
            </ComboBox>
            <Button x:Name="PreviewSourceButton" Content="All sources ▾" Height="34" Margin="0,0,7,5" Padding="8,4"
                MinWidth="{Binding MinWidth, ElementName=SourcePicker}" HorizontalContentAlignment="Left" FontSize="13"
                Style="{StaticResource ActionButton}" Visibility="Collapsed" AutomationProperties.Name="Launch source" Click="PreviewPickerClick"/>
            <Button x:Name="ImportButton" Content="Import library ▾" Style="{StaticResource ActionButton}" Padding="8,4" Height="34"
                Margin="0,0,7,5" AutomationProperties.Name="Import library" Click="ShowImportMenu"/>
            <Button x:Name="AddGameButton" Content="+ Add app ▾" AutomationProperties.Name="Add app" Style="{StaticResource ActionButton}"
                Background="{DynamicResource AppAccent}" BorderBrush="{DynamicResource AppAccent}" Foreground="{DynamicResource AppAccentInk}"
                FontWeight="SemiBold" Height="34" Padding="9,4" Margin="0,0,0,5" Click="ShowAddMenu"/>
          </WrapPanel>
          <local:LibraryScrollViewer x:Name="LibraryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False">
            <WrapPanel x:Name="Covers" Margin="6,6,7,0"/>
          </local:LibraryScrollViewer>
        </Grid>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource AppEdge}" BorderThickness="0,1,0,0" Background="{DynamicResource AppPanel}" Padding="13,6">
        <DockPanel>
          <TextBlock x:Name="BuildNumber" DockPanel.Dock="Right" Margin="12,0,0,0"
              Foreground="{DynamicResource AppMuted}" FontSize="12"/>
          <TextBlock x:Name="Status" Foreground="{DynamicResource AppMuted}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" FontSize="12"/>
        </DockPanel>
      </Border>
    </Grid>
    <Canvas x:Name="MenuLayer" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="2"
        KeyboardNavigation.TabNavigation="Cycle" PreviewMouseDown="DismissMenuOnBackdrop"/>
    <Grid x:Name="PanelLayer" Visibility="Collapsed" Panel.ZIndex="3" ClipToBounds="True" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="PanelScrim" Background="#A0000000" PreviewMouseLeftButtonDown="DismissPanelOnBackdrop"/>
      <local:AppearanceHighlight x:Name="LiveHighlight"/>
      <Border x:Name="Drawer" Width="485" HorizontalAlignment="Right" VerticalAlignment="Stretch"
          Background="{DynamicResource AppPanel}" BorderBrush="{DynamicResource AppEdge}" BorderThickness="1,0,0,0" Padding="18,16">
        <Border.RenderTransform><TranslateTransform x:Name="DrawerMotion"/></Border.RenderTransform>
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button x:Name="CloseDrawerButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Width="32" Height="32" Padding="0"
                Content="✕" Click="CloseDrawer" AutomationProperties.Name="Close panel" ToolTip="Close panel (Esc)"/>
            <TextBlock x:Name="DrawerTitle" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
          </DockPanel>
          <ContentControl x:Name="DrawerContent" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Focusable="False"/>
        </DockPanel>
      </Border>
    </Grid>
    <Grid x:Name="QuitLayer" Visibility="Collapsed" Panel.ZIndex="4" Background="#A6000000"
        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
      <Border MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
          CornerRadius="{DynamicResource AppControlCorner}" Padding="19,16" BorderThickness="1" BorderBrush="{DynamicResource AppEdge}"
          Background="{DynamicResource AppPanel}" AutomationProperties.Name="Close AppDex confirmation">
        <StackPanel>
          <TextBlock Text="Are you sure you want to close AppDex?" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="Playtime tracking and launch hotkeys will not be functional." Foreground="{DynamicResource AppMuted}"
              TextWrapping="Wrap" Margin="0,8,0,16"/>
          <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="KeepOpenButton" Content="Keep open" Click="KeepOpen" IsDefault="True"
                Style="{StaticResource ActionButton}" Margin="0,0,7,4"/>
            <Button x:Name="ConfirmQuitButton" Content="Close AppDex" Click="AcceptQuit" Style="{StaticResource ActionButton}"
                Foreground="{DynamicResource AppDanger}" Margin="0,0,0,4"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="LaunchNotice" Panel.ZIndex="5" Visibility="Collapsed" IsHitTestVisible="False"
        HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="460" Margin="16,0,16,36" Padding="12,9"
        CornerRadius="{DynamicResource AppControlCorner}" Background="{DynamicResource AppPanel}"
        BorderBrush="{DynamicResource AppDanger}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
            Foreground="{DynamicResource AppDanger}" Margin="0,1,9,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="LaunchNoticeText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
