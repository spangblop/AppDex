<Window x:Class="GameShelf.QuickLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AppDex Quick launch" Width="460" SizeToContent="Height" ShowInTaskbar="False"
    WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
    Background="{DynamicResource AppPanel}" Foreground="{DynamicResource AppText}"
    PreviewKeyDown="HandleKeys" Deactivated="Dismiss">
  <Border BorderBrush="{DynamicResource AppEdge}" BorderThickness="1" Padding="16">
    <StackPanel>
      <TextBlock Text="Quick launch" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <TextBox x:Name="Query" AutomationProperties.Name="Search apps" FontSize="17" Padding="8"
          Background="{DynamicResource AppControl}" Foreground="{DynamicResource AppText}"
          BorderBrush="{DynamicResource AppEdge}" CaretBrush="{DynamicResource AppText}" TextChanged="Search"/>
      <ListBox x:Name="Results" AutomationProperties.Name="Matching apps" MaxHeight="298" Margin="0,9,0,0"
          Background="{DynamicResource AppPanel}" Foreground="{DynamicResource AppText}" BorderThickness="0"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LaunchResult">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,3">
              <Image Width="53" Height="30" Stretch="UniformToFill" Source="{Binding Artwork}" Margin="0,0,9,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                <TextBlock Text="{Binding SourceStatus}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="NoResults" Text="No matching apps" Margin="0,7" Foreground="{DynamicResource AppMuted}"/>
      <DockPanel Margin="0,10,0,0">
        <Button x:Name="LaunchButton" DockPanel.Dock="Right" Content="Launch" Click="LaunchResult"
            Style="{DynamicResource ActionButton}" Background="{DynamicResource AppAccent}"
            Foreground="{DynamicResource AppAccentInk}"/>
        <TextBlock Text="↑ ↓ Select    Enter Launch    Esc Close" VerticalAlignment="Center" Foreground="{DynamicResource AppMuted}"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
